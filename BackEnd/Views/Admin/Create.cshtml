@model BackEnd.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<style>
    .form-container {
        width: 500px;
        margin: 40px auto;
        background: #fff;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }

        .form-container h2 {
            text-align: center;
            margin-bottom: 20px;
        }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            font-weight: 600;
        }

        .form-group input {
            width: 100%;
            height: 38px;
            border-radius: 8px;
            border: 1px solid #ddd;
            padding-left: 10px;
        }

    .btn-submit {
        width: 100%;
        height: 42px;
        background: linear-gradient(135deg,#28a745,#20c997);
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
    }

    .btn-back {
        display: block;
        text-align: center;
        margin-top: 10px;
        color: #555;
        text-decoration: none;
    }
</style>

<div class="form-container">
    <h2>➕ Thêm sản phẩm</h2>

    <form method="post">

        <div class="form-group">
            <label>Tên sản phẩm</label>
            <input asp-for="Name" />
        </div>

        <div class="form-group">
            <label>Ảnh (URL)</label>
            <input asp-for="Image" />
        </div>

        <div class="form-group">
            <label>Rating</label>
            <input asp-for="Rating" />
        </div>

        <div class="form-group">
            <label>Số đánh giá</label>
            <input asp-for="ReviewCount" />
        </div>

        <button type="submit" class="btn-submit">Thêm</button>

        <a href="/Admin" class="btn-back">⬅ Quay lại</a>

    </form>
</div>