@model BackEnd.Models.Product

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<style>
    .form-container {
        width: 500px;
        margin: 40px auto;
        background: #fff;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }

        .form-container h2 {
            text-align: center;
            margin-bottom: 20px;
        }

    /* ảnh preview */
    .preview-img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 15px;
        border: 1px solid #ddd;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group input {
            width: 100%;
            height: 38px;
            border-radius: 8px;
            border: 1px solid #ddd;
            padding-left: 10px;
        }

    .btn-submit {
        width: 100%;
        height: 42px;
        background: linear-gradient(135deg,#ffc107,#ff9800);
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
    }

    .btn-back {
        display: block;
        text-align: center;
        margin-top: 10px;
        color: #555;
        text-decoration: none;
    }
</style>

<div class="form-container">
    <h2>✏️ Sửa sản phẩm</h2>

    <!-- 🔥 ẢNH HIỆN TẠI -->
    <img id="preview" class="preview-img" src="@Model.Image" />

    <form method="post">

        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label>Tên sản phẩm</label>
            <input asp-for="Name" />
        </div>

        <div class="form-group">
            <label>Link ảnh</label>
            <input asp-for="Image" id="imageInput" />
        </div>

        <div class="form-group">
            <label>Rating</label>
            <input asp-for="Rating" />
        </div>

        <div class="form-group">
            <label>Số đánh giá</label>
            <input asp-for="ReviewCount" />
        </div>

        <button type="submit" class="btn-submit">Lưu</button>

        <a href="/Admin" class="btn-back">⬅ Quay lại</a>

    </form>
</div>

<script>
    // 🔥 PREVIEW ẢNH KHI NHẬP LINK
    document.getElementById("imageInput").addEventListener("input", function () {
        document.getElementById("preview").src = this.value;
    });
</script>