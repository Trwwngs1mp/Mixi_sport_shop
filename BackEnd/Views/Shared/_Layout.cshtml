@using Microsoft.AspNetCore.Http


<!DOCTYPE html>
<html lang="vi">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Shop Mixi Sport</title>

    <link rel="stylesheet" href="~/css/home.css" />

    <!-- ICON -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>

        /* ===== DROPDOWN FIX ===== */

        .menu-dropdown {
            position: relative;
            display: inline-flex;
            align-items: center;
        }

        /* dropdown box */

        .dropdown-content {
            position: absolute;
            top: 100%;
            left: 0;
            margin-top: 0;
            background: white;
            min-width: 220px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            overflow: hidden;
            display: none;
            z-index: 999;
        }

            /* item */

            .dropdown-content a {
                display: block;
                padding: 14px 16px;
                text-decoration: none;
                color: #111;
                font-weight: 700;
            }

                .dropdown-content a:hover {
                    background: #f5f5f5;
                    color: #e63946;
                }

        /* animation */

        @@keyframes dropdownSlide {
            from

        {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        /* class JS */

        .dropdown-show {
            display: block;
            animation: dropdownSlide .25s ease;
        }

    </style>

</head>

<body>

    <header class="site-header">

        <div class="header-inner container">

            <div class="header-left">

                <a href="/Home">
                    <img src="/images/logo.jpg" class="logo-img">
                </a>

            </div>

            <div class="header-center">

                <span class="brand-text">Shop Mixi Sport</span>

            </div>

            <nav class="header-right">

                <a href="/Home">
                    <i class="fa-solid fa-house"></i> Trang chủ
                </a>

                <div class="menu-dropdown">

                    <a href="/product">
                        <i class="fa-solid fa-box-open"></i> Sản phẩm
                    </a>

                    <div class="dropdown-content">

                        <a href="/Product/QuanAo">Quần áo</a>

                        <a href="/Product/Giay">Giày</a>

                        <a href="/Product/DungCu">Dụng cụ</a>

                        <a href="/Product/ThucPham">Thực phẩm</a>

                    </div>

                </div>

                <a href="/Cart">
                    <i class="fa-solid fa-cart-shopping"></i> Giỏ hàng
                </a>

               

                @if (Context.Session.GetString("Username") != null)
                {
                    <a href="/Account/Logout" class="btn btn-outline-danger btn-sm">
                        Đăng xuất
                    </a>

                    @if (Context.Session.GetString("Role") == "Admin")
                    {
                        <a href="/Admin" class="nav-link">
                            <i class="fa-solid fa-admin"></i>Quản lý
                        </a>
                    }
                }
                else
                {
                    <a class="nav-link" href="/Account/Login">
                        <i class="fa-solid fa-user"></i> Đăng nhập
                    </a>
                }







               
            </nav>

        </div>

    </header>


    <main class="site-main">

        <div class="container">

            @RenderBody()

        </div>

    </main>


    <footer class="site-footer">

        <div class="container">

            <div class="footer-grid">

                <!-- CỘT 1 -->

                <div class="footer-col">

                    <h3>Liên hệ với chúng tôi</h3>

                    <a href="https://www.facebook.com/MixiGaming" target="_blank">
                        <img src="/images/facebook.png"> Facebook
                    </a>

                    <a href="https://www.youtube.com/@@MixiGaming3con" target="_blank">
                        <img src="/images/youtube.png"> Youtube
                    </a>

                    <a href="https://www.tiktok.com/@@mixigaming" target="_blank">
                        <img src="/images/tiktok.png"> TikTok
                    </a>

                </div>


                <!-- CỘT 2 -->

                <div class="footer-col">

                    <h3>Chính sách bảo hành</h3>

                    <p>
                        Shop Mixi Sport cam kết cung cấp sản phẩm thể thao
                        chất lượng và đảm bảo quyền lợi cho khách hàng.
                    </p>

                    <p>
                        Nếu sản phẩm gặp lỗi từ nhà sản xuất hoặc hư hỏng
                        trong quá trình vận chuyển, khách hàng có thể
                        yêu cầu đổi sản phẩm trong vòng <b>7 ngày</b>
                        kể từ ngày nhận hàng.
                    </p>

                    <p>
                        Chúng tôi luôn hỗ trợ nhanh chóng để mang đến
                        trải nghiệm mua sắm tốt nhất cho khách hàng.
                    </p>

                </div>


                <!-- CỘT 3 -->

                <div class="footer-col">

                    <h3>Địa chỉ làm việc</h3>

                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3671.2079562221334!2d105.80996818015738!3d21.010490338493685!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135ac9d65911ef1%3A0x6a4df45cca423e18!2zMTIwIFAuWcOqbiBMw6NuZywgVGjhu4tuaCBRdWFuZywgxJDhu5FuZyDEkGEsIEjDoCBO4buZaSAxMDAwMDAsIFZp4buHdCBOYW0!5e1!3m2!1svi!2s!4v1773648423020!5m2!1svi!2s"
                            width="400"
                            height="300"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy">
                    </iframe>

                </div>

            </div>

            <p class="copyright">
                Copyright © 2026 | Shop Mixi Sport
            </p>

        </div>

    </footer>


    <script>

        document.addEventListener("DOMContentLoaded", function(){

        const dropdown = document.querySelector(".menu-dropdown");
        const menu = document.querySelector(".dropdown-content");

        dropdown.addEventListener("mouseenter", function(){

        menu.classList.add("dropdown-show");

        });

        dropdown.addEventListener("mouseleave", function(){

        menu.classList.remove("dropdown-show");

        });

        });

    </script>

</body>
</html>